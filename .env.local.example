# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Upstash Redis (for presence / socket state) ───────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ── Google OAuth (identity only — no Drive) ───────────────────────────────────
# Used ONLY for "Continue with Google" sign-in.
# No Drive API keys needed — Drive integration has been removed.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── LiveKit Calling ──────────────────────────────────────────────────────────
# Public LiveKit WebRTC/WebSocket connection URL (wss://...)
NEXT_PUBLIC_LIVEKIT_URL=wss://readroom-gy5lg1ce.livekit.cloud
